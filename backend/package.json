{
  "name": "civicfix-backend",
  "version": "1.0.0",
  "description": "Backend API for CivicFix - Public Issue Reporting System",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "start:user": "node server-user.js",
    "dev:user": "nodemon server-user.js",
    "start:municipal": "node server-municipal.js",
    "dev:municipal": "nodemon server-municipal.js",
    "start:contractor": "node server-contractor.js",
    "dev:contractor": "node scripts/start-contractor-dev.js",
    "kill:8001": "node scripts/kill-port.js 8001",
    "kill:8000": "node scripts/kill-port.js 8000",
    "kill:5000": "node scripts/kill-port.js 5000",
    "seed:municipal": "node scripts/seedMunicipalData.js",
