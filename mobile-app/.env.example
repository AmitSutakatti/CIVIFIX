# ============================================================
#  CivicFix Mobile App — Environment Variables Template
#  Copy this file to .env and fill in your values.
#  NEVER commit .env to version control.
# ============================================================

# -------------------------------------------------------
# BACKEND API URL
# -------------------------------------------------------
# This is the ONLY place you configure the backend URL.
# Every other file reads from this variable via constants/config.js
#
# IMPORTANT — Do NOT use "localhost" on a physical Android/iOS device.
#   localhost on a device refers to the device itself, not your machine.
#
# LOCAL DEVELOPMENT (physical device on same Wi-Fi):
#   Find your machine's LAN IP:
#     Windows: Run  ipconfig  → look for "IPv4 Address"
#     Mac/Linux: Run  ifconfig  → look for "inet" under en0 or eth0
#   Then set:
#     EXPO_PUBLIC_API_URL=http://192.168.x.x:5000/api
#
# LOCAL DEVELOPMENT (Expo Go on emulator/simulator):
#   Android emulator: use 10.0.2.2 (special alias for host machine)
#     EXPO_PUBLIC_API_URL=http://10.0.2.2:5000/api
#   iOS simulator:   use localhost directly
#     EXPO_PUBLIC_API_URL=http://localhost:5000/api
#
# PRODUCTION (permanently deployed HTTPS backend):
#   EXPO_PUBLIC_API_URL=https://api.yourcivicfix.com/api
#
EXPO_PUBLIC_API_URL=http://192.168.x.x:5000/api

# -------------------------------------------------------
# UPLOADS BASE URL  (for local /uploads/ image paths)
# -------------------------------------------------------
# When ImageKit CDN is configured on the server, images
# are stored as full https://ik.imagekit.io/... URLs and
# this variable is not used for those images.
#
# This is ONLY used as a prefix for relative image paths
# like /uploads/filename.jpg returned by the backend
# when ImageKit is not configured.
#
# Must match the scheme+host+port of EXPO_PUBLIC_API_URL
# but WITHOUT the /api suffix.
#
# Examples:
#   EXPO_PUBLIC_UPLOADS_BASE_URL=http://192.168.x.x:5000
#   EXPO_PUBLIC_UPLOADS_BASE_URL=https://api.yourcivicfix.com
#
EXPO_PUBLIC_UPLOADS_BASE_URL=http://192.168.x.x:5000

# -------------------------------------------------------
# APP ENVIRONMENT
# -------------------------------------------------------
# Controls debug logging, error verbosity, etc.
# Values: development | production
#
EXPO_PUBLIC_ENV=development

# -------------------------------------------------------
# REQUEST TIMEOUT (milliseconds)
# -------------------------------------------------------
# How long Axios waits before timing out a request.
# Default: 15000 (15 seconds)
# Increase on slow networks, decrease for snappy UX.
#
EXPO_PUBLIC_API_TIMEOUT=15000
