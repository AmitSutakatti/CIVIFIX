# CivicFix Mobile App — PRODUCTION environment
# -------------------------------------------------------
# Replace the placeholder URL with your permanently
# deployed HTTPS backend URL before running a production
# build (eas build --profile production).
#
# This file should be committed to version control
# ONLY after replacing the placeholder (no secrets here —
# the URL is not sensitive).
#
# Never put API keys, JWT secrets, or database URIs here.
# All secrets stay in backend/.env on the server.
# -------------------------------------------------------

EXPO_PUBLIC_API_URL=https://api.yourcivicfix.com/api
EXPO_PUBLIC_UPLOADS_BASE_URL=https://api.yourcivicfix.com
EXPO_PUBLIC_ENV=production
EXPO_PUBLIC_API_TIMEOUT=20000
