# ──────────────────────────────────────────────────────────
#  CivicFix Mobile App — .gitignore
# ──────────────────────────────────────────────────────────

# ── Environment files ──────────────────────────────────────
# .env contains your local LAN IP — never commit it.
# .env.local is for machine-specific overrides — never commit it.
# .env.production is committed (no secrets, only the URL).
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# ── Expo / React Native ────────────────────────────────────
node_modules/
.expo/
dist/
web-build/
.expo-shared/

# ── EAS (Expo Application Services) ──────────────────────
.eas/

# ── OS / editor ───────────────────────────────────────────
.DS_Store
Thumbs.db
*.log
.vscode/settings.json
.idea/

# ── Native build outputs ──────────────────────────────────
android/
ios/
*.apk
*.aab
*.ipa
